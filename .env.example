# Server-only credentials. Do not commit actual values or expose them to client code.
# Run `node scripts/owner-credentials.mjs` privately to generate these values.
OWNER_PASSWORD_HASH=<salt-hex>:<scrypt-hash-hex>
OWNER_SESSION_SECRET=<random-secret-at-least-48-characters>
# Connect an existing Vercel Blob store to this project. OIDC is used on Vercel
# when BLOB_STORE_ID and VERCEL_OIDC_TOKEN are available. Outside Vercel,
# the SDK may instead use BLOB_READ_WRITE_TOKEN, which must remain server-only.
BLOB_STORE_ID=<existing-store-id>
# Must match the connected cms-media store. This project uses its public access.
BLOB_ACCESS=public
